# Application
APP_NAME=NaijaSound AI
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=replace-this-with-a-long-random-string-from-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60 * 24 * 7  # 7 days

# Database (use postgresql+asyncpg for prod, sqlite+aiosqlite for dev)
DATABASE_URL=sqlite+aiosqlite:///./naijasound.db

# CORS — comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# AI Service (Tempolor / ElevenLabs / whatever you plug in)
AI_API_BASE_URL=https://api.your-ai-provider.com/v1
AI_API_KEY=your_ai_api_key_here
AI_LYRICS_MODEL=lyric-v1
AI_MUSIC_MODEL=eleven-music-v2

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=naijasound/tracks

# First superuser (optional, created on startup if DB is empty)
FIRST_SUPERUSER_EMAIL=admin@naijasound.ai
FIRST_SUPERUSER_PASSWORD=ChangeMe123!
