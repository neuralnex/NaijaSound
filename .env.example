# Application
APP_NAME=NaijaSound AI
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=replace-this-with-a-long-random-string-from-openssl-rand-hex-32
ALGORITHM=HS256
# 7 days
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (use postgresql+asyncpg for prod, sqlite+aiosqlite for dev)
DATABASE_URL=sqlite+aiosqlite:///./naijasound.db

# CORS — comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# AI Service — Tempolor
# Base URL is https://api.tempolor.com and the open-apis version is /open-apis/v1
AI_API_BASE_URL=https://api.tempolor.com/open-apis/v1

# Each request must include the API key in the Authorization header:
#   Authorization: <your_api_key>
# Tempolor keys are issued in the form `Tempo-********************************-3w`.
# Paste the full key (including the `Tempo-` prefix and trailing suffix) below —
# it is sent verbatim, NOT as a Bearer token.
AI_API_KEY=Tempo-replace-with-your-tempolor-api-key-3w

# Model identifiers used for each endpoint (Tempolor)
# Eleven Music V2 — vocal or instrumental tracks (up to 5 min, 44.1kHz MP3/WAV). 70 credits/call.
AI_MUSIC_MODEL=Eleven Music V2
# Lyric v1 — lyrics from a theme/description. 1 credit/call.
AI_LYRICS_MODEL=Lyric v1
# tempolor-latest — reference-based cover/remix generation (vocal only). 10 credits/call.
AI_COVER_MODEL=tempolor-latest
# Stem separation — Stems v2 (4-stem, 5 credits/call) or Stems v3 (8-stem, 15 credits/call).
AI_STEMS_MODEL=Stems v2

# Public URL Tempolor will POST back to when async generation finishes.
# Must be reachable from the internet. For local dev, use ngrok/cloudflare tunnel
# (e.g. https://yourdomin.com/music-gen/tempolor/callback).
AI_CALLBACK_URL=https://yourdomin.com/music-gen/tempolor/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=naijasound/tracks

# First superuser (optional, created on startup if DB is empty)
FIRST_SUPERUSER_EMAIL=admin@naijasound.ai
FIRST_SUPERUSER_PASSWORD=ChangeMe123!
